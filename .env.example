# MDTS public sharing template
# 실제 값은 공개 저장소에 커밋하지 않는다.

# Frontend
VITE_LEGACY_API_BASE=http://localhost:4000/api
VITE_AI_API_BASE=http://localhost:8000
VITE_SENSOR_API_BASE=http://YOUR_RPI_HOST:5000

# Node API
MDTS_API_PORT=4000
MDTS_SENSOR_API_BASE=http://YOUR_RPI_HOST:5000
MDTS_AI_API_BASE=http://localhost:8000

# Remote DB
MDTS_REMOTE_DB_HOST=YOUR_REMOTE_DB_HOST
MDTS_REMOTE_DB_PORT=3306
MDTS_REMOTE_DB_USER=YOUR_REMOTE_DB_USER
MDTS_REMOTE_DB_PASSWORD=YOUR_REMOTE_DB_PASSWORD
MDTS_REMOTE_DB_NAME=YOUR_REMOTE_DB_NAME

# Local/Edge DB
MDTS_LOCAL_DB_HOST=YOUR_RPI_HOST
MDTS_LOCAL_DB_PORT=3306
MDTS_LOCAL_DB_USER=YOUR_LOCAL_DB_USER
MDTS_LOCAL_DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD
MDTS_LOCAL_DB_NAME=YOUR_LOCAL_DB_NAME

# Edge devices
MDTS_PI_HOST=YOUR_RPI_HOST
MDTS_PI_USER=YOUR_RPI_USER
MDTS_PI_PASSWORD=YOUR_RPI_PASSWORD
MDTS_JETSON_HOST=YOUR_JETSON_HOST
MDTS_JETSON_USER=YOUR_JETSON_USER
MDTS_JETSON_PASSWORD=YOUR_JETSON_PASSWORD
JETSON_CONTROL_BASE=http://YOUR_JETSON_HOST:5055

# AI
MDTS_OLLAMA_HOST=localhost
MDTS_OLLAMA_PORT=11434
MDTS_OBSIDIAN_DIR=./knowledge
MDTS_OBSIDIAN_AUTO_SYNC=0
MDTS_OBSIDIAN_SYNC_SEC=60
